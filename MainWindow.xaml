<Window x:Class="TransparentPrompterOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transparent Prompter Overlay"
        Width="1120"
        Height="780"
        MinWidth="760"
        MinHeight="520"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E2F0" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#22162131" />
            <Setter Property="BorderBrush" Value="#2FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2234465A" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#181A2435" />
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181A2435" />
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5EDF7" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="{Binding OverlayBackgroundBrush}"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="28"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Color="#B0000000"
                                  Opacity="0.42"
                                  ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#18050A16"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#18FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="Teleprompter Overlay" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           Foreground="#B8FFFFFF"
                                           Text="Drag here to move the overlay." />
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           Foreground="#90FFFFFF"
                                           Text="Glass-style prompt stage with manual, timed, and voice-follow modes." />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#16FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Margin="0,0,8,0"
                                    Padding="10,6">
                                <TextBlock FontFamily="Bahnschrift"
                                           FontSize="11"
                                           Foreground="White"
                                           Text="{Binding ModeBadgeText}" />
                            </Border>

                            <Border Background="#16FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Margin="0,0,8,0"
                                    Padding="10,6">
                                <TextBlock FontFamily="Bahnschrift"
                                           FontSize="11"
                                           Foreground="#DDE7F4"
                                           Text="{Binding PlaybackBadgeText}" />
                            </Border>

                            <Border Background="#16FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="10,6">
                                <TextBlock FontFamily="Bahnschrift"
                                           FontSize="11"
                                           Foreground="#DDE7F4"
                                           Text="F8 click-through • F9 show/hide • F10 play • F11/F12 adjust" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Click="ToggleClickThroughButton_OnClick"
                                    Content="{Binding PrimaryActionButtonLabel}" />
                            <Button Click="HideOverlayButton_OnClick"
                                    Content="Hide" />
                            <Button Click="ResetViewButton_OnClick"
                                    Content="Reset" />
                            <Button Click="CloseButton_OnClick"
                                    Content="Close"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Playback" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#A7B5C9"
                                               Text="Choose how the script moves." />

                                    <TextBlock Style="{StaticResource LabelTextStyle}"
                                               Text="Scroll mode" />
                                    <ComboBox DisplayMemberPath="Name"
                                              ItemsSource="{Binding TeleprompterModeOptions}"
                                              SelectedValue="{Binding Settings.TeleprompterMode, Mode=TwoWay}"
                                              SelectedValuePath="Value" />

                                    <StackPanel Margin="0,12,0,0"
                                                Orientation="Horizontal">
                                        <Button Click="PlaybackButton_OnClick"
                                                Content="{Binding PlaybackButtonLabel}" />
                                        <Button Click="RestartFromTopButton_OnClick"
                                                Content="Restart from top" />
                                    </StackPanel>

                                    <TextBlock Margin="0,12,0,0"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#D8E2F0"
                                               Text="{Binding PlaybackStatusText}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontFamily="Bahnschrift"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Text="{Binding VoiceStatusText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Speed and Timing" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#A7B5C9"
                                               Text="Manual mode uses pixels per second. Timed mode finishes within your target time." />

                                    <TextBlock Style="{StaticResource LabelTextStyle}"
                                               Text="Manual speed" />
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Maximum="220"
                                                Minimum="10"
                                                TickFrequency="5"
                                                Value="{Binding Settings.ManualScrollSpeed, Mode=TwoWay}" />
                                        <TextBlock FontFamily="Bahnschrift"
                                                   Foreground="White"
                                                   Text="{Binding ManualSpeedDisplayText}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Button Click="FasterButton_OnClick"
                                                Content="Faster" />
                                        <Button Click="SlowerButton_OnClick"
                                                Content="Slower" />
                                    </StackPanel>

                                    <TextBlock Margin="0,14,0,0"
                                               Style="{StaticResource LabelTextStyle}"
                                               Text="Timed duration (mm:ss)" />
                                    <TextBox HorizontalAlignment="Left"
                                             Text="{Binding TimedDurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontFamily="Bahnschrift"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Text="{Binding TimedDurationHelperText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Visuals" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#A7B5C9"
                                               Text="Keep the stage readable without blocking too much of your screen." />

                                    <TextBlock Style="{StaticResource LabelTextStyle}"
                                               Text="Overlay opacity" />
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Maximum="0.78"
                                                Minimum="0.12"
                                                TickFrequency="0.02"
                                                Value="{Binding Settings.OverlayOpacity, Mode=TwoWay}" />
                                        <TextBlock FontFamily="Bahnschrift"
                                                   Foreground="White"
                                                   Text="{Binding Settings.OverlayOpacity, StringFormat={}{0:P0}}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource LabelTextStyle}"
                                               Text="Font size" />
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Maximum="76"
                                                Minimum="20"
                                                TickFrequency="2"
                                                Value="{Binding Settings.FontSize, Mode=TwoWay}" />
                                        <TextBlock FontFamily="Bahnschrift"
                                                   Foreground="White"
                                                   Text="{Binding Settings.FontSize, StringFormat={}{0:0}}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource LabelTextStyle}"
                                               Text="Text color" />
                                    <ComboBox DisplayMemberPath="Name"
                                              ItemsSource="{Binding TextColorOptions}"
                                              SelectedValue="{Binding Settings.TextColorHex, Mode=TwoWay}"
                                              SelectedValuePath="Hex" />

                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource LabelTextStyle}"
                                               Text="Alignment" />
                                    <ComboBox DisplayMemberPath="Name"
                                              ItemsSource="{Binding TextAlignmentOptions}"
                                              SelectedValue="{Binding Settings.TextAlignment, Mode=TwoWay}"
                                              SelectedValuePath="Value" />

                                    <CheckBox Margin="0,12,0,0"
                                              Content="Mirror prompt text for reflective teleprompter glass"
                                              IsChecked="{Binding Settings.MirrorText, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Window" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#A7B5C9"
                                               Text="Resize the overlay without turning it into a normal app window." />

                                    <TextBlock Style="{StaticResource LabelTextStyle}"
                                               Text="Width" />
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Maximum="1600"
                                                Minimum="760"
                                                TickFrequency="20"
                                                Value="{Binding Settings.WindowWidth, Mode=TwoWay}" />
                                        <TextBlock FontFamily="Bahnschrift"
                                                   Foreground="White"
                                                   Text="{Binding Settings.WindowWidth, StringFormat={}{0:0}}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource LabelTextStyle}"
                                               Text="Height" />
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Maximum="980"
                                                Minimum="520"
                                                TickFrequency="20"
                                                Value="{Binding Settings.WindowHeight, Mode=TwoWay}" />
                                        <TextBlock FontFamily="Bahnschrift"
                                                   Foreground="White"
                                                   Text="{Binding Settings.WindowHeight, StringFormat={}{0:0}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Rephrase Assistant" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               Foreground="#A7B5C9"
                                               Text="Select text in the editor, or place the caret inside a paragraph, to generate easier-to-say alternatives." />

                                    <Button Click="RephraseSelectionButton_OnClick"
                                            Content="Rephrase selection" />

                                    <TextBlock Margin="0,10,0,0"
                                               FontFamily="Bahnschrift"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Text="{Binding RephraseStatusText}" />

                                    <ItemsControl ItemsSource="{Binding RephraseSuggestions}"
                                                  Visibility="{Binding RephraseSuggestionsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141E293B"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Margin="0,10,0,0"
                                                        Padding="12">
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Bahnschrift"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Margin="0,8,0,10"
                                                                   FontFamily="Bahnschrift SemiLight"
                                                                   FontSize="12"
                                                                   Foreground="#E2E8F0"
                                                                   Text="{Binding Text}"
                                                                   TextWrapping="Wrap" />
                                                        <Button Click="ApplySuggestionButton_OnClick"
                                                                Content="Use this version"
                                                                Tag="{Binding}"
                                                                HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#10060C17"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="18">
                            <Grid>
                                <TextBox x:Name="PromptDisplayTextBox"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Bahnschrift SemiLight"
                                         FontSize="{Binding Settings.FontSize}"
                                         Foreground="{Binding TextBrush}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         Padding="46,200,46,200"
                                         SelectionBrush="#44FFFFFF"
                                         Text="{Binding Settings.ScriptText}"
                                         TextAlignment="{Binding Settings.TextAlignment}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Hidden"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Focusable="False"
                                         IsTabStop="False">
                                    <TextBox.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding PromptScaleX}"
                                                        ScaleY="1" />
                                    </TextBox.LayoutTransform>
                                </TextBox>

                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#14060C17"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="14"
                                Visibility="{Binding EditorVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="190" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontFamily="Bahnschrift"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="Editable script" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   Foreground="#A7B5C9"
                                                   Text="Type, paste, or revise your script here. The prompt stage above updates immediately." />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Click="RephraseSelectionButton_OnClick"
                                            Content="Rephrase selection"
                                            Margin="12,0,0,0" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <TextBox x:Name="EditorTextBox"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             FontFamily="Bahnschrift SemiLight"
                                             FontSize="15"
                                             Foreground="#FFF8FAFC"
                                             SelectionBrush="#55FFFFFF"
                                             SpellCheck.IsEnabled="True"
                                             Text="{Binding Settings.ScriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />

                                    <TextBlock Margin="12,10,42,0"
                                               FontFamily="Bahnschrift SemiLight"
                                               FontSize="15"
                                               Foreground="#6FD8E2F0"
                                               IsHitTestVisible="False"
                                               Text="Paste or type your script. Select a tricky line or paragraph to get simpler phrasing suggestions."
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Visibility="{Binding EmptyEditorHintVisibility}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Bahnschrift"
                               FontSize="12"
                               Foreground="#D8E2F0"
                               Text="{Binding StatusLineText}" />

                    <Thumb Grid.Column="1"
                           Width="22"
                           Height="22"
                           Cursor="SizeNWSE"
                           DragDelta="ResizeThumb_OnDragDelta"
                           Opacity="0.85">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid>
                                    <Path Data="M3,19 L19,3 M8,19 L19,8 M13,19 L19,13"
                                          Stroke="#AAFFFFFF"
                                          StrokeThickness="1.4"
                                          SnapsToDevicePixels="True" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
